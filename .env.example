# Copy to .env.local and fill in. Never commit real keys.

# --- LLM (T-4, T-5) ---------------------------------------------------------
LLM_PROVIDER=claude
# Claude credentials: an API key, or leave empty after `ant auth login`.
ANTHROPIC_API_KEY=
# Default model for every AI task. Per-task override: AI_MODEL_<TASK_IN_UPPER_SNAKE>,
# e.g. AI_MODEL_EVALUATE_SPEAKING=...
AI_MODEL=claude-opus-5-5

# --- Speech assessment and text-to-speech (§5.2, T-4) ------------------------
SPEECH_PROVIDER=azure
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Database (T-6) -----------------------------------------------------------
# Local development uses an embedded PostgreSQL (PGlite) in ./.data/pglite.
# Production: a real PostgreSQL URL, e.g. postgres://user:pass@host:5432/french_app
DATABASE_URL=pglite:./.data/pglite
