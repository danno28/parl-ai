# Copy to .env.local and fill in. Never commit real keys.

# --- Login (U-1, U-6) --------------------------------------------------------
# Random secret, 32+ characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated emails allowed to sign up (invite-only). Rows in the invites table also count.
INVITED_EMAILS=

# --- Email (magic links) -------------------------------------------------------
# console: the link is printed in the server log (local development)
# resend:  sent through Resend (https://resend.com); EMAIL_FROM must be a verified sender
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="parl.ai <login@example.com>"

# --- LLM (T-4, T-5) ------------------------------------------------------------
LLM_PROVIDER=claude
# Claude credentials: an API key, or leave empty after `ant auth login`.
ANTHROPIC_API_KEY=
# Default model for every AI task. Per-task override: AI_MODEL_<TASK_IN_UPPER_SNAKE>,
# e.g. AI_MODEL_EVALUATE_SPEAKING=...
AI_MODEL=claude-opus-5-5

# --- Speech assessment and text-to-speech (§5.2, T-4) --------------------------
# One Azure "Speech" resource provides both. Region example: westeurope, francecentral.
SPEECH_PROVIDER=azure
TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional voice override per language, e.g. fr-FR-HenriNeural (default fr-FR-DeniseNeural)
AZURE_TTS_VOICE_FR=
# Where synthesized sentences are cached
TTS_CACHE_DIR=./.data/tts-cache

# --- Database (T-6) ---------------------------------------------------------------
# Local development uses an embedded PostgreSQL (PGlite) in ./.data/pglite.
# Production: a real PostgreSQL URL, e.g. postgres://user:pass@host:5432/parl_ai
DATABASE_URL=pglite:./.data/pglite
